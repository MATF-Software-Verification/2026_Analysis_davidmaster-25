---
# Clang-Tidy yaml konfiguracija
# Fokus: Detekcija bugova, modernizacija i citljivost koda

Checks: >
  bugprone-*,
  clang-analyzer-*,
  google-*,
  modernize-*,
  readability-*,
  cppcoreguidelines-no-automatic-goto,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-specialization-types,
  -readability-braces-around-statements,
  -readability-magic-numbers,
  -bugprone-argument-comment

WarningsAsErrors: ''

CheckOptions:
  - key:             modernize-use-nullptr.Check
    value:           'true'
  - key:             cppcoreguidelines-pro-type-member-init.Check
    value:           'true'
---
